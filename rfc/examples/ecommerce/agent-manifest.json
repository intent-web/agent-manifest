{
  "$schema": "../../schemas/agent-manifest.v0.1.schema.json",
  "agentManifestVersion": "0.1-draft",
  "id": "example-ecommerce-store",
  "status": "example",
  "templateKind": "ecommerce",
  "identity": {
    "name": "Example Store",
    "domain": "example.com",
    "owner": "Example Store Inc.",
    "contact": "shop@example.com",
    "jurisdiction": "US"
  },
  "platform": {
    "type": "ecommerce-website",
    "stack": [
      "commerce-platform",
      "openapi",
      "mcp"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Expose product knowledge as public catalog data.",
      "Require governed runtime execution for checkout and order actions."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent.json",
      "/agent-manifest.json"
    ],
    "llmContext": [
      "/llms.txt"
    ],
    "openapi": "/ai/openapi.json",
    "mcp": "/ai/mcp"
  },
  "knowledge": [
    {
      "id": "products",
      "type": "product-catalog",
      "source": "/ai/catalog/products.json",
      "refresh": "hourly"
    },
    {
      "id": "store-policies",
      "type": "policy",
      "source": "/policies",
      "refresh": "on policy change"
    }
  ],
  "capabilities": [
    {
      "id": "search-products",
      "name": "Search products",
      "description": "Find products.",
      "intent": "find_products",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/search-products.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        },
        {
          "kind": "openapi",
          "spec": "/ai/openapi.json",
          "operationId": "findProducts",
          "priority": 2,
          "schemaMode": "external"
        },
        {
          "kind": "mcp",
          "server": "/ai/mcp",
          "tool": "find_products",
          "priority": 3,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "query",
        "result_count"
      ]
    },
    {
      "id": "prepare-checkout",
      "name": "Prepare checkout",
      "description": "Prepare checkout for review.",
      "intent": "prepare_checkout_for_review",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/prepare-checkout.input.json",
      "outputSchema": "/ai/schemas/prepare-checkout.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "openapi",
          "spec": "/ai/openapi.json",
          "operationId": "prepareCheckoutForReview",
          "priority": 1,
          "schemaMode": "external"
        },
        {
          "kind": "mcp",
          "server": "/ai/mcp",
          "tool": "prepare_checkout_for_review",
          "priority": 2,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "cart_summary",
        "user_confirmation",
        "timestamp"
      ]
    },
    {
      "id": "place-order",
      "name": "Place order",
      "description": "Place order.",
      "intent": "place_order",
      "type": "transaction",
      "risk": "critical",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/place-order.input.json",
      "outputSchema": "/ai/schemas/place-order.output.json",
      "authorization": {
        "authProfiles": [
          "customer-session",
          "hosted-checkout-confirmation"
        ],
        "consentMode": "provider_confirmed",
        "idempotencyRequired": true,
        "auditRequired": true,
        "consentBinding": [
          "capabilityId",
          "inputHash",
          "userOrSession",
          "timestamp",
          "protocolInvocation"
        ]
      },
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "hosted-checkout",
          "url": "/checkout",
          "method": "GET",
          "priority": 1,
          "schemaMode": "external"
        }
      ],
      "protocols": [
        "hosted-checkout"
      ],
      "audit": [
        "order_summary",
        "explicit_approval",
        "payment_reference",
        "timestamp"
      ]
    }
  ],
  "policies": {
    "consent": "Cart and order actions require user-visible summaries and explicit confirmation.",
    "auth": "Customer-specific checkout actions require authenticated customer context.",
    "dataMinimization": "Expose only public product data and collect only checkout fields required for fulfillment.",
    "audit": "Critical order actions require immutable audit records."
  },
  "authProfiles": [
    {
      "id": "customer-session",
      "type": "session",
      "maxRisk": "critical",
      "description": "Authenticated customer session used for checkout-specific operations."
    },
    {
      "id": "hosted-checkout-confirmation",
      "type": "hosted-confirmation",
      "maxRisk": "critical",
      "description": "Provider-controlled checkout confirmation surface."
    }
  ],
  "extensionPoints": [
    "openapi.example.json",
    "mcp-server.example.json",
    "policy.example.json"
  ]
}
