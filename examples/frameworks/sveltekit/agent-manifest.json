{
  "agentManifestVersion": "0.1-draft",
  "id": "sveltekit-site",
  "status": "example",
  "templateKind": "framework-sveltekit",
  "identity": {
    "name": "Example SvelteKit Site",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "web@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "ssr-or-static-framework",
    "stack": [
      "sveltekit",
      "svelte",
      "adapter-static-or-node"
    ],
    "integrationMode": "static-or-runtime",
    "servingNotes": [
      "Static adapters should emit manifest files into the output root.",
      "SSR adapters can expose manifest and OpenAPI through server endpoints."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent-manifest.json",
      "/api/agent/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/sveltekit/site-summary.txt"
    ],
    "openapi": "/api/agent/openapi.json",
    "mcp": "/api/agent/mcp"
  },
  "knowledge": [
    {
      "id": "routes",
      "type": "route-catalog",
      "source": "/ai/sveltekit/routes.json",
      "refresh": "on build"
    },
    {
      "id": "content",
      "type": "content-catalog",
      "source": "/ai/sveltekit/content.json",
      "refresh": "on build"
    },
    {
      "id": "actions",
      "type": "form-action-catalog",
      "source": "/ai/sveltekit/actions.json",
      "refresh": "on build"
    }
  ],
  "capabilities": [
    {
      "id": "search-content",
      "name": "Search content",
      "description": "Find public content.",
      "intent": "find_public_content",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/search-content.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        },
        {
          "kind": "http",
          "endpoint": "/api/agent/search-content",
          "method": "GET",
          "contentType": "application/json",
          "priority": 2,
          "schemaMode": "none",
          "sourceAdapter": "endpoint"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "submit-form-action",
      "name": "Submit form action",
      "description": "Submit form request.",
      "intent": "submit_form_request",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/submit-form-action.input.json",
      "outputSchema": "/ai/schemas/submit-form-action.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/submit-form-action",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "form-action"
        }
      ],
      "audit": [
        "form_id",
        "input_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "request-offer",
      "name": "Request offer",
      "description": "Request commercial offer.",
      "intent": "request_commercial_offer",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/request-offer.input.json",
      "outputSchema": "/ai/schemas/request-offer.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/request-offer",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "endpoint"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "SvelteKit form actions that submit data require confirmation.",
    "auth": "Session-specific load data and private endpoints require authentication.",
    "dataMinimization": "Do not expose private environment values or server-only modules.",
    "audit": "State-changing endpoints should write audit records."
  },
  "extensionPoints": [
    "sveltekit-adapter-policy.md",
    "endpoint-openapi.json",
    "form-actions-policy.json",
    "static-output-policy.md"
  ]
}
