{
  "agentManifestVersion": "0.1-draft",
  "id": "nuxt-site",
  "status": "example",
  "templateKind": "framework-nuxt",
  "identity": {
    "name": "Example Nuxt Site",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "web@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "vue-ssr-framework",
    "stack": [
      "nuxt",
      "vue",
      "nitro",
      "server-routes"
    ],
    "integrationMode": "static-or-runtime",
    "servingNotes": [
      "For static generation, emit manifests into public output.",
      "For SSR/Nitro, serve manifest via server route before fallback handling."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent-manifest.json",
      "/api/agent/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/llms-full.txt"
    ],
    "openapi": "/api/agent/openapi.json",
    "mcp": "/api/agent/mcp"
  },
  "knowledge": [
    {
      "id": "routes",
      "type": "route-catalog",
      "source": "/ai/nuxt/routes.json",
      "refresh": "on build"
    },
    {
      "id": "content",
      "type": "content-catalog",
      "source": "/ai/nuxt/content.json",
      "refresh": "on build or content update"
    },
    {
      "id": "server-routes",
      "type": "api-catalog",
      "source": "/ai/nuxt/server-routes.json",
      "refresh": "on build"
    }
  ],
  "capabilities": [
    {
      "id": "search-content",
      "name": "Search content",
      "description": "Find public content.",
      "intent": "find_public_content",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/search-content.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        },
        {
          "kind": "http",
          "endpoint": "/api/agent/search-content",
          "method": "GET",
          "contentType": "application/json",
          "priority": 2,
          "schemaMode": "none",
          "sourceAdapter": "nitro-route"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "submit-form",
      "name": "Submit form",
      "description": "Submit form request.",
      "intent": "submit_form_request",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/submit-form.input.json",
      "outputSchema": "/ai/schemas/submit-form.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/submit-form",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "nitro-route"
        }
      ],
      "audit": [
        "form_id",
        "input_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "request-offer",
      "name": "Request offer",
      "description": "Request commercial offer.",
      "intent": "request_commercial_offer",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/request-offer.input.json",
      "outputSchema": "/ai/schemas/request-offer.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/request-offer",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "nitro-route"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "Server routes that submit user data require confirmation.",
    "auth": "Private runtime config and authenticated endpoints must not be public capabilities.",
    "dataMinimization": "Do not expose private runtime config or server-only plugin state.",
    "audit": "State-changing Nitro routes should write audit records."
  },
  "extensionPoints": [
    "nuxt-module.md",
    "nitro-route-openapi.json",
    "static-generation-policy.md",
    "runtime-config-policy.json"
  ]
}
