{
  "agentManifestVersion": "0.1-draft",
  "id": "laravel-site",
  "status": "example",
  "templateKind": "framework-laravel",
  "identity": {
    "name": "Example Laravel App",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "web@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "php-web-framework",
    "stack": [
      "laravel",
      "php",
      "blade-or-inertia",
      "eloquent"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Define manifest routes outside auth-only route groups.",
      "Generate capability metadata from routes, form requests, policies and resources."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/laravel/site-summary.txt"
    ],
    "openapi": "/agent/openapi.json",
    "mcp": "/agent/mcp"
  },
  "knowledge": [
    {
      "id": "routes",
      "type": "route-catalog",
      "source": "/ai/laravel/routes.json",
      "refresh": "on deploy"
    },
    {
      "id": "resources",
      "type": "resource-catalog",
      "source": "/ai/laravel/resources.json",
      "refresh": "on deploy"
    },
    {
      "id": "policies",
      "type": "policy",
      "source": "/ai/laravel/policies.json",
      "refresh": "on policy change"
    }
  ],
  "capabilities": [
    {
      "id": "search-public-data",
      "name": "Search public data",
      "description": "Find public information.",
      "intent": "find_public_information",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/search-public-data",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "route"
        },
        {
          "kind": "openapi",
          "spec": "/agent/openapi.json",
          "operationId": "findPublicInformation",
          "priority": 2,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "submit-form-request",
      "name": "Submit form request",
      "description": "Submit form request.",
      "intent": "submit_form_request",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/submit-form-request.input.json",
      "outputSchema": "/ai/schemas/submit-form-request.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/submit-form-request",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "controller"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "execute-domain-command",
      "name": "Execute domain command",
      "description": "Execute business command.",
      "intent": "execute_business_command",
      "type": "action",
      "risk": "high",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/execute-domain-command.input.json",
      "outputSchema": "/ai/schemas/execute-domain-command.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/execute-domain-command",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "controller"
        }
      ],
      "audit": [
        "command",
        "input_summary",
        "explicit_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "State-changing routes require confirmation and may dispatch auditable jobs.",
    "auth": "Gate and policy requirements must be reflected in capability metadata.",
    "dataMinimization": "Do not expose hidden model fields, config secrets or admin routes.",
    "audit": "Use events, jobs or dedicated audit tables for agent actions."
  },
  "extensionPoints": [
    "laravel-package.md",
    "route-introspection.json",
    "policy-mapping.json",
    "agent-audit-events.md"
  ]
}
