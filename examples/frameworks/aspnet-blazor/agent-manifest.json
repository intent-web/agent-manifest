{
  "agentManifestVersion": "0.1-draft",
  "id": "aspnet-blazor-site",
  "status": "example",
  "templateKind": "framework-aspnet-blazor",
  "identity": {
    "name": "Example Blazor App",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "web@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "dotnet-web-app",
    "stack": [
      "asp.net-core",
      "blazor-server-or-webassembly",
      "minimal-api-optional"
    ],
    "integrationMode": "static-or-runtime",
    "servingNotes": [
      "For Blazor WebAssembly, include manifest files in wwwroot.",
      "For Blazor Server, serve manifest through static files or a minimal API endpoint before fallback routing."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent-manifest.json"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/blazor/app-summary.txt"
    ],
    "openapi": "/swagger/agent-openapi.json",
    "mcp": "/ai/mcp"
  },
  "knowledge": [
    {
      "id": "routes",
      "type": "route-catalog",
      "source": "/ai/blazor/routes.json",
      "refresh": "on build"
    },
    {
      "id": "components",
      "type": "ui-capability-catalog",
      "source": "/ai/blazor/components.json",
      "refresh": "on build"
    },
    {
      "id": "policies",
      "type": "policy",
      "source": "/ai/blazor/policies.json",
      "refresh": "on policy change"
    }
  ],
  "capabilities": [
    {
      "id": "read-app-summary",
      "name": "Read app summary",
      "description": "Understand application.",
      "intent": "understand_application",
      "type": "resource",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/read-app-summary.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        }
      ],
      "audit": [
        "request_id"
      ]
    },
    {
      "id": "query-public-data",
      "name": "Query public data",
      "description": "Query public application data.",
      "intent": "query_public_application_data",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/query-public-data",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "minimal-api"
        },
        {
          "kind": "openapi",
          "spec": "/swagger/agent-openapi.json",
          "operationId": "queryPublicApplicationData",
          "priority": 2,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "submit-workflow-request",
      "name": "Submit workflow request",
      "description": "Start business workflow.",
      "intent": "start_business_workflow",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/submit-workflow-request.input.json",
      "outputSchema": "/ai/schemas/submit-workflow-request.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/submit-workflow-request",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "minimal-api"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "Workflow actions require explicit confirmation.",
    "auth": "User-specific Blazor circuits, claims and account data require authenticated context.",
    "dataMinimization": "Do not expose connection strings, circuit identifiers or server-only configuration.",
    "audit": "Use application logging or a dedicated audit store for state-changing actions."
  },
  "extensionPoints": [
    "blazor-routing.md",
    "minimal-api-openapi.json",
    "auth-policy.json",
    "wwwroot-static-files.md"
  ]
}
