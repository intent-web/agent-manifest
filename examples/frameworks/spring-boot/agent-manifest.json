{
  "agentManifestVersion": "0.1-draft",
  "id": "spring-boot-site",
  "status": "example",
  "templateKind": "framework-spring-boot",
  "identity": {
    "name": "Example Spring Boot App",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "api@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "java-web-framework",
    "stack": [
      "spring-boot",
      "spring-mvc-or-webflux",
      "spring-security",
      "openapi-optional"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Serve manifest from static resources or a controller endpoint.",
      "Map Spring Security authorities and method security to capability rules."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/spring/site-summary.txt"
    ],
    "openapi": "/v3/api-docs/agent",
    "mcp": "/agent/mcp"
  },
  "knowledge": [
    {
      "id": "controllers",
      "type": "route-catalog",
      "source": "/ai/spring/controllers.json",
      "refresh": "on deploy"
    },
    {
      "id": "public-data",
      "type": "data-catalog",
      "source": "/agent/public-data",
      "refresh": "daily"
    },
    {
      "id": "security",
      "type": "policy",
      "source": "/ai/spring/security-policy.json",
      "refresh": "on security policy change"
    }
  ],
  "capabilities": [
    {
      "id": "query-public-data",
      "name": "Query public data",
      "description": "Query public application data.",
      "intent": "query_public_application_data",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/query-public-data",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "controller"
        },
        {
          "kind": "openapi",
          "spec": "/v3/api-docs/agent",
          "operationId": "queryPublicApplicationData",
          "priority": 2,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "submit-request",
      "name": "Submit request",
      "description": "Submit business request.",
      "intent": "submit_business_request",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/submit-request.input.json",
      "outputSchema": "/ai/schemas/submit-request.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/submit-request",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "controller"
        },
        {
          "kind": "openapi",
          "spec": "/v3/api-docs/agent",
          "operationId": "submitBusinessRequest",
          "priority": 2,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "execute-command",
      "name": "Execute command",
      "description": "Execute business command.",
      "intent": "execute_business_command",
      "type": "action",
      "risk": "high",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/execute-command.input.json",
      "outputSchema": "/ai/schemas/execute-command.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/execute-command",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "controller"
        }
      ],
      "audit": [
        "command",
        "input_summary",
        "explicit_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "State-changing commands require confirmation and may require re-authentication.",
    "auth": "Spring Security roles, scopes and method security must map to capability metadata.",
    "dataMinimization": "Do not expose actuator secrets, internal beans or private configuration.",
    "audit": "Use structured application events or audit tables for state-changing agent actions."
  },
  "extensionPoints": [
    "spring-controller.md",
    "spring-security-mapping.json",
    "agent-openapi-profile.json",
    "audit-event-schema.json"
  ]
}
