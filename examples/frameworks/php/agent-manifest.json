{
  "agentManifestVersion": "0.1-draft",
  "id": "plain-php-site",
  "status": "example",
  "templateKind": "framework-php",
  "identity": {
    "name": "Example PHP Site",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "web@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "server-rendered-website",
    "stack": [
      "php",
      "apache-or-nginx",
      "mysql-optional"
    ],
    "integrationMode": "static-or-bridge",
    "servingNotes": [
      "Serve manifest through a static file or a PHP endpoint with application/json content type.",
      "Keep action handlers separate from public content discovery."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent-manifest.php"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/php/site-summary.txt"
    ],
    "openapi": "/ai/openapi.json",
    "mcp": "/ai/mcp"
  },
  "knowledge": [
    {
      "id": "pages",
      "type": "page-catalog",
      "source": "/ai/php/pages.json",
      "refresh": "on deploy"
    },
    {
      "id": "services",
      "type": "service-catalog",
      "source": "/ai/php/services.json",
      "refresh": "on deploy"
    },
    {
      "id": "forms",
      "type": "form-catalog",
      "source": "/ai/php/forms.json",
      "refresh": "on deploy"
    }
  ],
  "capabilities": [
    {
      "id": "search-pages",
      "name": "Search pages",
      "description": "Find public information.",
      "intent": "find_public_information",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/search-pages.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        },
        {
          "kind": "http",
          "endpoint": "/api/agent/search-pages",
          "method": "GET",
          "contentType": "application/json",
          "priority": 2,
          "schemaMode": "none",
          "sourceAdapter": "php-json-endpoint"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "request-offer",
      "name": "Request offer",
      "description": "Request commercial offer.",
      "intent": "request_commercial_offer",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/request-offer.input.json",
      "outputSchema": "/ai/schemas/request-offer.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/request-offer",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "php-action-gateway"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation",
        "timestamp"
      ]
    },
    {
      "id": "book-consultation-request",
      "name": "Book consultation request",
      "description": "Request booking followup.",
      "intent": "request_booking_followup",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/book-consultation-request.input.json",
      "outputSchema": "/ai/schemas/book-consultation-request.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/book-consultation-request",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "php-action-gateway"
        }
      ],
      "audit": [
        "requested_slot",
        "input_summary",
        "user_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "Any POST action that submits user data requires confirmation.",
    "auth": "Admin panels and session-only routes must not be listed as public capabilities.",
    "dataMinimization": "Do not expose database credentials, session IDs or server paths.",
    "audit": "Persist agent submissions with request id and sanitized input summary."
  },
  "extensionPoints": [
    "php-action-gateway.md",
    "apache-nginx-routing.md",
    "form-schema.json",
    "csrf-policy.json"
  ]
}
