{
  "agentManifestVersion": "0.1-draft",
  "id": "express-node-site",
  "status": "example",
  "templateKind": "framework-express-node",
  "identity": {
    "name": "Example Express Site",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "api@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "node-web-framework",
    "stack": [
      "node.js",
      "express",
      "templates-or-api"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Expose manifest through express.static or an explicit JSON route.",
      "Keep agent action routes separate from generic browser endpoints."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/express/site-summary.txt"
    ],
    "openapi": "/agent/openapi.json",
    "mcp": "/agent/mcp"
  },
  "knowledge": [
    {
      "id": "routes",
      "type": "route-catalog",
      "source": "/ai/express/routes.json",
      "refresh": "on deploy"
    },
    {
      "id": "public-data",
      "type": "data-catalog",
      "source": "/agent/public-data",
      "refresh": "daily"
    },
    {
      "id": "forms",
      "type": "form-catalog",
      "source": "/ai/express/forms.json",
      "refresh": "on deploy"
    }
  ],
  "capabilities": [
    {
      "id": "search-public-data",
      "name": "Search public data",
      "description": "Find public information.",
      "intent": "find_public_information",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/search-public-data",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "express-route"
        },
        {
          "kind": "static",
          "url": "/ai/capabilities/search-public-data.json",
          "method": "GET",
          "priority": 2,
          "schemaMode": "none"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "submit-contact",
      "name": "Submit contact",
      "description": "Submit contact request.",
      "intent": "submit_contact_request",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/submit-contact.input.json",
      "outputSchema": "/ai/schemas/submit-contact.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/submit-contact",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "express-route"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "trigger-workflow",
      "name": "Trigger workflow",
      "description": "Start business workflow.",
      "intent": "start_business_workflow",
      "type": "action",
      "risk": "high",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/trigger-workflow.input.json",
      "outputSchema": "/ai/schemas/trigger-workflow.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/trigger-workflow",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "express-route"
        }
      ],
      "audit": [
        "workflow",
        "input_summary",
        "explicit_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "POST/PATCH/DELETE agent routes require risk-based confirmation.",
    "auth": "Middleware authentication and authorization must be represented in capability metadata.",
    "dataMinimization": "Do not expose environment variables, internal route handlers or secrets.",
    "audit": "Use structured logs with request id and user confirmation for state-changing routes."
  },
  "extensionPoints": [
    "express-middleware.md",
    "route-registry.json",
    "openapi-generator.md",
    "queue-audit-policy.json"
  ]
}
