{
  "agentManifestVersion": "0.1-draft",
  "id": "aspnet-mvc-site",
  "status": "example",
  "templateKind": "framework-aspnet-mvc",
  "identity": {"name": "Example ASP.NET MVC Site", "domain": "example.com", "owner": "Example Organization", "contact": "web@example.com", "jurisdiction": "TODO"},
  "platform": {"type": "server-rendered-website", "stack": ["asp.net-core", "mvc-or-razor-pages", "controllers", "entity-framework-optional"], "integrationMode": "bridge-or-runtime", "servingNotes": ["Serve manifest before MVC fallback or catch-all routes.", "Use controllers/minimal APIs for governed agent actions."]},
  "discovery": {"recommendedLocations": ["/.well-known/agent-manifest.json", "/agent/manifest"], "llmContext": ["/llms.txt", "/ai/aspnet/site-summary.txt"], "openapi": "/swagger/agent-openapi.json", "mcp": "/agent/mcp"},
  "knowledge": [
    {"id": "routes", "type": "route-catalog", "source": "/ai/aspnet/routes.json", "refresh": "on deploy"},
    {"id": "public-data", "type": "data-catalog", "source": "/agent/public-data-catalog", "refresh": "daily"},
    {"id": "forms", "type": "form-catalog", "source": "/ai/aspnet/forms.json", "refresh": "on deploy"}
  ],
  "capabilities": [
    {"id": "search-site", "intent": "find_public_information", "risk": "low", "stateChange": false, "requiresConsent": false, "protocols": ["controller", "static"], "audit": ["query"]},
    {"id": "submit-contact", "intent": "submit_contact_request", "risk": "medium", "stateChange": true, "requiresConsent": true, "protocols": ["controller-action", "openapi"], "audit": ["input_summary", "user_confirmation"]},
    {"id": "start-domain-workflow", "intent": "start_business_workflow", "risk": "high", "stateChange": true, "requiresConsent": true, "protocols": ["controller-action", "openapi"], "audit": ["workflow_type", "input_summary", "explicit_confirmation"]}
  ],
  "policies": {"consent": "High-risk workflows require explicit confirmation and may require re-authentication.", "auth": "Authorize attributes and role policies must be reflected in capability exposure.", "dataMinimization": "Do not expose internal model fields, antiforgery tokens or server configuration.", "audit": "Correlate agent actions with ASP.NET request ids and authenticated user ids when present."},
  "extensionPoints": ["mvc-controller-mapping.md", "authorization-policy.json", "swagger-agent-profile.json", "audit-middleware.md"]
}

