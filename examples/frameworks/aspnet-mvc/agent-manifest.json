{
  "agentManifestVersion": "0.1-draft",
  "id": "aspnet-mvc-site",
  "status": "example",
  "templateKind": "framework-aspnet-mvc",
  "identity": {
    "name": "Example ASP.NET MVC Site",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "web@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "server-rendered-website",
    "stack": [
      "asp.net-core",
      "mvc-or-razor-pages",
      "controllers",
      "entity-framework-optional"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Serve manifest before MVC fallback or catch-all routes.",
      "Use controllers/minimal APIs for governed agent actions."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/aspnet/site-summary.txt"
    ],
    "openapi": "/swagger/agent-openapi.json",
    "mcp": "/agent/mcp"
  },
  "knowledge": [
    {
      "id": "routes",
      "type": "route-catalog",
      "source": "/ai/aspnet/routes.json",
      "refresh": "on deploy"
    },
    {
      "id": "public-data",
      "type": "data-catalog",
      "source": "/agent/public-data-catalog",
      "refresh": "daily"
    },
    {
      "id": "forms",
      "type": "form-catalog",
      "source": "/ai/aspnet/forms.json",
      "refresh": "on deploy"
    }
  ],
  "capabilities": [
    {
      "id": "search-site",
      "name": "Search site",
      "description": "Find public information.",
      "intent": "find_public_information",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/search-site",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "controller"
        },
        {
          "kind": "static",
          "url": "/ai/capabilities/search-site.json",
          "method": "GET",
          "priority": 2,
          "schemaMode": "none"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "submit-contact",
      "name": "Submit contact",
      "description": "Submit contact request.",
      "intent": "submit_contact_request",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/submit-contact.input.json",
      "outputSchema": "/ai/schemas/submit-contact.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/submit-contact",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "controller-action"
        },
        {
          "kind": "openapi",
          "spec": "/swagger/agent-openapi.json",
          "operationId": "submitContactRequest",
          "priority": 2,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "start-domain-workflow",
      "name": "Start domain workflow",
      "description": "Start business workflow.",
      "intent": "start_business_workflow",
      "type": "action",
      "risk": "high",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/start-domain-workflow.input.json",
      "outputSchema": "/ai/schemas/start-domain-workflow.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/start-domain-workflow",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "controller-action"
        },
        {
          "kind": "openapi",
          "spec": "/swagger/agent-openapi.json",
          "operationId": "startBusinessWorkflow",
          "priority": 2,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "workflow_type",
        "input_summary",
        "explicit_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "High-risk workflows require explicit confirmation and may require re-authentication.",
    "auth": "Authorize attributes and role policies must be reflected in capability exposure.",
    "dataMinimization": "Do not expose internal model fields, antiforgery tokens or server configuration.",
    "audit": "Correlate agent actions with ASP.NET request ids and authenticated user ids when present."
  },
  "extensionPoints": [
    "mvc-controller-mapping.md",
    "authorization-policy.json",
    "swagger-agent-profile.json",
    "audit-middleware.md"
  ]
}
