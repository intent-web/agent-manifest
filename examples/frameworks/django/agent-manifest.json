{
  "agentManifestVersion": "0.1-draft",
  "id": "django-site",
  "status": "example",
  "templateKind": "framework-django",
  "identity": {
    "name": "Example Django Site",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "web@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "python-web-framework",
    "stack": [
      "django",
      "python",
      "templates-or-drf",
      "orm"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Serve manifest through staticfiles or a JSON view.",
      "Generate capability metadata from URL patterns, serializers, forms and permissions."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/django/site-summary.txt"
    ],
    "openapi": "/agent/openapi.json",
    "mcp": "/agent/mcp"
  },
  "knowledge": [
    {
      "id": "urls",
      "type": "route-catalog",
      "source": "/ai/django/urls.json",
      "refresh": "on deploy"
    },
    {
      "id": "models",
      "type": "public-model-catalog",
      "source": "/ai/django/models.json",
      "refresh": "on deploy"
    },
    {
      "id": "forms",
      "type": "form-catalog",
      "source": "/ai/django/forms.json",
      "refresh": "on deploy"
    }
  ],
  "capabilities": [
    {
      "id": "search-public-content",
      "name": "Search public content",
      "description": "Find public content.",
      "intent": "find_public_content",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/search-public-content",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "view"
        },
        {
          "kind": "static",
          "url": "/ai/capabilities/search-public-content.json",
          "method": "GET",
          "priority": 2,
          "schemaMode": "none"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "submit-form",
      "name": "Submit form",
      "description": "Submit form request.",
      "intent": "submit_form_request",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/submit-form.input.json",
      "outputSchema": "/ai/schemas/submit-form.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/submit-form",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "view"
        }
      ],
      "audit": [
        "form_id",
        "input_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "start-workflow",
      "name": "Start workflow",
      "description": "Start business workflow.",
      "intent": "start_business_workflow",
      "type": "action",
      "risk": "high",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/start-workflow.input.json",
      "outputSchema": "/ai/schemas/start-workflow.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/start-workflow",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "view"
        }
      ],
      "audit": [
        "workflow_type",
        "input_summary",
        "explicit_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "POST actions require confirmation; high-risk workflows may require re-authentication.",
    "auth": "Django permissions and DRF permission classes must map to capability exposure.",
    "dataMinimization": "Do not expose secret settings, staff routes or private model fields.",
    "audit": "Use structured logging or audit models for state-changing actions."
  },
  "extensionPoints": [
    "django-app.md",
    "drf-openapi-profile.json",
    "permission-mapping.json",
    "celery-audit-policy.md"
  ]
}
