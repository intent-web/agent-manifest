{
  "agentManifestVersion": "0.1-draft",
  "id": "shopify-store",
  "status": "example",
  "templateKind": "ecommerce-shopify",
  "identity": {"name": "Example Shopify Store", "domain": "example.com", "owner": "Example Merchant", "contact": "shop@example.com", "jurisdiction": "TODO"},
  "platform": {"type": "hosted-ecommerce", "stack": ["shopify", "liquid", "storefront-api", "app-extension"], "integrationMode": "static-or-runtime", "servingNotes": ["Publish static manifest files through theme assets or a storefront route where possible.", "Use an app proxy or external runtime for governed actions."]},
  "discovery": {"recommendedLocations": ["/.well-known/agent-manifest.json", "/apps/agent-layer/manifest"], "llmContext": ["/llms.txt", "/ai/shopify/catalog-summary.txt"], "openapi": "/apps/agent-layer/openapi.json", "mcp": "/apps/agent-layer/mcp"},
  "knowledge": [
    {"id": "products", "type": "product-catalog", "source": "/ai/shopify/products.json", "refresh": "on product webhook"},
    {"id": "collections", "type": "collection-catalog", "source": "/ai/shopify/collections.json", "refresh": "on collection webhook"},
    {"id": "store-policies", "type": "policy", "source": "/policies", "refresh": "on policy change"}
  ],
  "capabilities": [
    {"id": "search-products", "intent": "find_products", "risk": "low", "stateChange": false, "requiresConsent": false, "protocols": ["storefront-api", "static"], "audit": ["query"]},
    {"id": "check-variant", "intent": "check_variant_availability", "risk": "low", "stateChange": false, "requiresConsent": false, "protocols": ["storefront-api"], "audit": ["variant_id"]},
    {"id": "prepare-checkout", "intent": "prepare_checkout_for_review", "risk": "medium", "stateChange": true, "requiresConsent": true, "protocols": ["app-proxy", "agent-action-gateway"], "audit": ["checkout_summary", "user_confirmation"]},
    {"id": "complete-checkout", "intent": "complete_purchase", "risk": "critical", "stateChange": true, "requiresConsent": true, "protocols": ["hosted-checkout"], "audit": ["checkout_url", "total", "explicit_approval"]}
  ],
  "policies": {"consent": "Checkout must be reviewed with items, variants, shipping, taxes, discounts and total before purchase.", "auth": "Customer account data requires customer authentication.", "dataMinimization": "Do not expose private app tokens or admin API details.", "audit": "Store checkout and user confirmation references outside public theme assets."},
  "extensionPoints": ["shopify-app-proxy.md", "storefront-api-mapping.md", "checkout-policy.json", "webhook-refresh-policy.json"]
}

