{
  "agentManifestVersion": "0.1-draft",
  "id": "opencart-store",
  "status": "example",
  "templateKind": "ecommerce-opencart",
  "identity": {
    "name": "Example OpenCart Store",
    "domain": "example.com",
    "owner": "Example Merchant",
    "contact": "orders@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "self-hosted-ecommerce",
    "stack": [
      "opencart",
      "php",
      "mysql",
      "extensions"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Implement manifests through an extension or static export.",
      "Route state-changing actions through an extension controller with policy checks."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/index.php?route=extension/agent_layer/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/opencart/catalog-summary.txt"
    ],
    "openapi": "/index.php?route=extension/agent_layer/openapi",
    "mcp": "/index.php?route=extension/agent_layer/mcp"
  },
  "knowledge": [
    {
      "id": "products",
      "type": "product-catalog",
      "source": "/ai/opencart/products.json",
      "refresh": "on product update"
    },
    {
      "id": "categories",
      "type": "category-catalog",
      "source": "/ai/opencart/categories.json",
      "refresh": "on category update"
    },
    {
      "id": "shipping-payment",
      "type": "commerce-policy",
      "source": "/ai/opencart/checkout-policy.json",
      "refresh": "on extension setting change"
    }
  ],
  "capabilities": [
    {
      "id": "search-products",
      "name": "Search products",
      "description": "Find products.",
      "intent": "find_products",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/search-products.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        },
        {
          "kind": "http",
          "endpoint": "/api/agent/search-products",
          "method": "GET",
          "contentType": "application/json",
          "priority": 2,
          "schemaMode": "none",
          "sourceAdapter": "opencart-extension-api"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "estimate-total",
      "name": "Estimate total",
      "description": "Estimate order total.",
      "intent": "estimate_order_total",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/estimate-total",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "items",
        "destination"
      ]
    },
    {
      "id": "prepare-cart",
      "name": "Prepare cart",
      "description": "Prepare cart for review.",
      "intent": "prepare_cart_for_review",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/prepare-cart.input.json",
      "outputSchema": "/ai/schemas/prepare-cart.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/prepare-cart",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "cart_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "place-order",
      "name": "Place order",
      "description": "Place order.",
      "intent": "place_order",
      "type": "transaction",
      "risk": "critical",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/place-order.input.json",
      "outputSchema": "/ai/schemas/place-order.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/place-order",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "order_summary",
        "explicit_approval"
      ]
    }
  ],
  "policies": {
    "consent": "Orders require explicit approval of complete checkout summary.",
    "auth": "Customer account and order history actions require authentication.",
    "dataMinimization": "Only expose enabled products and public option values.",
    "audit": "Record agent action id, cart summary and user approval for checkout actions."
  },
  "extensionPoints": [
    "opencart-extension.md",
    "opencart-openapi.json",
    "option-normalization.json",
    "checkout-audit-schema.json"
  ]
}
