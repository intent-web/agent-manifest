{
  "agentManifestVersion": "0.1-draft",
  "id": "bigcommerce-store",
  "status": "example",
  "templateKind": "ecommerce-bigcommerce",
  "identity": {
    "name": "Example BigCommerce Store",
    "domain": "example.com",
    "owner": "Example Merchant",
    "contact": "commerce@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "hosted-ecommerce",
    "stack": [
      "bigcommerce",
      "stencil-or-headless",
      "storefront-api",
      "app"
    ],
    "integrationMode": "static-or-runtime",
    "servingNotes": [
      "Publish manifest through storefront assets, headless frontend or app integration.",
      "Use an app/runtime for governed cart and checkout actions."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/apps/agent-layer/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/bigcommerce/catalog-summary.txt"
    ],
    "openapi": "/apps/agent-layer/openapi.json",
    "mcp": "/apps/agent-layer/mcp"
  },
  "knowledge": [
    {
      "id": "products",
      "type": "product-catalog",
      "source": "/ai/bigcommerce/products.json",
      "refresh": "on catalog webhook"
    },
    {
      "id": "categories",
      "type": "category-catalog",
      "source": "/ai/bigcommerce/categories.json",
      "refresh": "on catalog webhook"
    },
    {
      "id": "storefront-policy",
      "type": "policy",
      "source": "/ai/bigcommerce/storefront-policy.json",
      "refresh": "on setting change"
    }
  ],
  "capabilities": [
    {
      "id": "search-products",
      "name": "Search products",
      "description": "Find products.",
      "intent": "find_products",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/search-products",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "storefront-api"
        },
        {
          "kind": "static",
          "url": "/ai/capabilities/search-products.json",
          "method": "GET",
          "priority": 2,
          "schemaMode": "none"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "check-product-options",
      "name": "Check product options",
      "description": "Validate product options.",
      "intent": "validate_product_options",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/check-product-options",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "storefront-api"
        }
      ],
      "audit": [
        "product_id",
        "options"
      ]
    },
    {
      "id": "prepare-checkout",
      "name": "Prepare checkout",
      "description": "Prepare checkout for review.",
      "intent": "prepare_checkout_for_review",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/prepare-checkout.input.json",
      "outputSchema": "/ai/schemas/prepare-checkout.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/prepare-checkout",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "checkout_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "complete-order",
      "name": "Complete order",
      "description": "Place order.",
      "intent": "place_order",
      "type": "transaction",
      "risk": "critical",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/complete-order.input.json",
      "outputSchema": "/ai/schemas/complete-order.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "hosted-checkout",
          "url": "/checkout",
          "method": "GET",
          "priority": 1,
          "schemaMode": "external"
        },
        {
          "kind": "http",
          "endpoint": "/api/agent/complete-order",
          "method": "POST",
          "contentType": "application/json",
          "priority": 2,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "order_summary",
        "explicit_approval"
      ]
    }
  ],
  "policies": {
    "consent": "Checkout requires item, option, shipping, tax, discount and total review before purchase.",
    "auth": "Customer group pricing and account data require authentication.",
    "dataMinimization": "Do not expose app tokens, private customer data or admin API routes.",
    "audit": "Critical checkout actions require app-side audit storage."
  },
  "extensionPoints": [
    "bigcommerce-app.md",
    "storefront-api-mapping.md",
    "checkout-policy.json",
    "catalog-webhook-policy.json"
  ]
}
