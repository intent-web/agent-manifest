{
  "agentManifestVersion": "0.1-draft",
  "id": "sylius-store",
  "status": "example",
  "templateKind": "ecommerce-sylius",
  "identity": {
    "name": "Example Sylius Store",
    "domain": "example.com",
    "owner": "Example Merchant",
    "contact": "commerce@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "headless-or-custom-commerce",
    "stack": [
      "sylius",
      "symfony",
      "php",
      "api-platform"
    ],
    "integrationMode": "runtime",
    "servingNotes": [
      "Use channel-aware manifests for different markets, currencies or locales.",
      "Prefer API Platform/OpenAPI exposure through a dedicated agent layer resource."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/api/agent-layer/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/sylius/catalog-summary.txt"
    ],
    "openapi": "/api/agent-layer/openapi.json",
    "mcp": "/api/agent-layer/mcp"
  },
  "knowledge": [
    {
      "id": "products",
      "type": "product-catalog",
      "source": "/ai/sylius/products.json",
      "refresh": "on product update"
    },
    {
      "id": "channels",
      "type": "storefront-context",
      "source": "/ai/sylius/channels.json",
      "refresh": "on channel update"
    },
    {
      "id": "promotions",
      "type": "commerce-policy",
      "source": "/ai/sylius/promotions.json",
      "refresh": "on promotion update"
    }
  ],
  "capabilities": [
    {
      "id": "search-products",
      "name": "Search products",
      "description": "Find products.",
      "intent": "find_products",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/search-products",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "api-platform"
        },
        {
          "kind": "static",
          "url": "/ai/capabilities/search-products.json",
          "method": "GET",
          "priority": 2,
          "schemaMode": "none"
        }
      ],
      "audit": [
        "query",
        "channel"
      ]
    },
    {
      "id": "calculate-order",
      "name": "Calculate order",
      "description": "Calculate order total.",
      "intent": "calculate_order_total",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/calculate-order",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "items",
        "channel",
        "address_region"
      ]
    },
    {
      "id": "prepare-checkout",
      "name": "Prepare checkout",
      "description": "Prepare checkout for review.",
      "intent": "prepare_checkout_for_review",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/prepare-checkout.input.json",
      "outputSchema": "/ai/schemas/prepare-checkout.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/prepare-checkout",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "checkout_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "complete-checkout",
      "name": "Complete checkout",
      "description": "Place order.",
      "intent": "place_order",
      "type": "transaction",
      "risk": "critical",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/complete-checkout.input.json",
      "outputSchema": "/ai/schemas/complete-checkout.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/complete-checkout",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "order_summary",
        "explicit_approval"
      ]
    }
  ],
  "policies": {
    "consent": "Order placement requires explicit approval of channel, currency, shipping, tax, promotions and total.",
    "auth": "Customer identity, address book and order history require authentication.",
    "dataMinimization": "Public catalogs must omit internal costs and unpublished channel assignments.",
    "audit": "Persist channel-aware audit records for every state-changing agent action."
  },
  "extensionPoints": [
    "sylius-api-platform.md",
    "channel-policy.json",
    "checkout-state-machine-policy.json",
    "sylius-openapi.json"
  ]
}
