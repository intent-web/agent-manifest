{
  "agentManifestVersion": "0.1-draft",
  "id": "drupal-site",
  "status": "example",
  "templateKind": "cms-drupal",
  "identity": {"name": "Example Drupal Site", "domain": "example.com", "owner": "Example Organization", "contact": "web@example.com", "jurisdiction": "TODO"},
  "platform": {"type": "cms", "stack": ["drupal", "php", "database", "views", "jsonapi"], "integrationMode": "static-or-bridge", "servingNotes": ["Generate knowledge from published nodes, taxonomies, menus and media only.", "Use JSON:API or a custom module for agent-safe content discovery."]},
  "discovery": {"recommendedLocations": ["/.well-known/agent-manifest.json", "/agent-layer/manifest"], "llmContext": ["/llms.txt", "/ai/drupal/content-summary.txt"], "openapi": "/agent-layer/openapi.json", "mcp": "/agent-layer/mcp"},
  "knowledge": [
    {"id": "nodes", "type": "content-catalog", "source": "/jsonapi/node", "refresh": "on content publish"},
    {"id": "taxonomy", "type": "taxonomy-catalog", "source": "/jsonapi/taxonomy_term", "refresh": "on taxonomy update"},
    {"id": "menus", "type": "navigation-catalog", "source": "/ai/drupal/menus.json", "refresh": "on menu update"}
  ],
  "capabilities": [
    {"id": "search-content", "intent": "find_public_content", "risk": "low", "stateChange": false, "requiresConsent": false, "protocols": ["jsonapi", "static"], "audit": ["query"]},
    {"id": "read-content-item", "intent": "read_public_content_item", "risk": "low", "stateChange": false, "requiresConsent": false, "protocols": ["jsonapi"], "audit": ["entity_id"]},
    {"id": "submit-webform", "intent": "submit_form_request", "risk": "medium", "stateChange": true, "requiresConsent": true, "protocols": ["custom-module", "webform-adapter"], "audit": ["form_id", "input_summary", "user_confirmation"]}
  ],
  "policies": {"consent": "Webform submissions require confirmation of the submitted summary.", "auth": "Editorial, draft and user-specific content require authenticated context.", "dataMinimization": "Exclude unpublished revisions, private files and admin routes.", "audit": "State-changing submissions should be logged outside public content indexes."},
  "extensionPoints": ["drupal-module.md", "jsonapi-mapping.json", "webform-adapter.md", "content-access-policy.json"]
}

