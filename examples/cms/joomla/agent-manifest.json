{
  "agentManifestVersion": "0.1-draft",
  "id": "joomla-site",
  "status": "example",
  "templateKind": "cms-joomla",
  "identity": {
    "name": "Example Joomla Site",
    "domain": "example.com",
    "owner": "Example Organization",
    "contact": "web@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "cms",
    "stack": [
      "joomla",
      "php",
      "mysql",
      "components",
      "modules"
    ],
    "integrationMode": "static-or-bridge",
    "servingNotes": [
      "Generate public catalogs from published articles, categories, menus and selected components.",
      "Expose agent capabilities through a component or static export."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/index.php?option=com_agentlayer&task=manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/joomla/content-summary.txt"
    ],
    "openapi": "/index.php?option=com_agentlayer&task=openapi",
    "mcp": "/index.php?option=com_agentlayer&task=mcp"
  },
  "knowledge": [
    {
      "id": "articles",
      "type": "content-catalog",
      "source": "/ai/joomla/articles.json",
      "refresh": "on article publish"
    },
    {
      "id": "categories",
      "type": "taxonomy-catalog",
      "source": "/ai/joomla/categories.json",
      "refresh": "on category update"
    },
    {
      "id": "menus",
      "type": "navigation-catalog",
      "source": "/ai/joomla/menus.json",
      "refresh": "on menu update"
    }
  ],
  "capabilities": [
    {
      "id": "search-articles",
      "name": "Search articles",
      "description": "Find public content.",
      "intent": "find_public_content",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/search-articles.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        },
        {
          "kind": "http",
          "endpoint": "/api/agent/search-articles",
          "method": "GET",
          "contentType": "application/json",
          "priority": 2,
          "schemaMode": "none",
          "sourceAdapter": "joomla-component"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "read-article",
      "name": "Read article",
      "description": "Read public article.",
      "intent": "read_public_article",
      "type": "resource",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/read-article",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "joomla-component"
        }
      ],
      "audit": [
        "article_id"
      ]
    },
    {
      "id": "submit-contact",
      "name": "Submit contact",
      "description": "Submit contact request.",
      "intent": "submit_contact_request",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/submit-contact.input.json",
      "outputSchema": "/ai/schemas/submit-contact.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/submit-contact",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "joomla-component"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation"
      ]
    }
  ],
  "policies": {
    "consent": "Contact submissions require explicit confirmation.",
    "auth": "Backend, unpublished and ACL-restricted resources require authenticated context.",
    "dataMinimization": "Do not publish private menu items, unpublished articles or extension secrets.",
    "audit": "Log form submissions with agent request id and user confirmation."
  },
  "extensionPoints": [
    "joomla-component.md",
    "content-export-schema.json",
    "contact-adapter.md",
    "acl-policy.json"
  ]
}
