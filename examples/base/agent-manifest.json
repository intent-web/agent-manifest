{
  "$schema": "../../rfc/schemas/agent-manifest.v0.1.schema.json",
  "agentManifestVersion": "0.1-draft",
  "id": "default-business-website",
  "status": "example",
  "templateKind": "default",
  "identity": {
    "name": "Example Organization",
    "domain": "example.com",
    "owner": "Example Organization Ltd.",
    "contact": "support@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "generic-website",
    "stack": [
      "html",
      "cms-or-custom-backend"
    ],
    "integrationMode": "static-or-bridge",
    "servingNotes": [
      "Serve the manifest as a real static file, not as a visual web page.",
      "Keep public knowledge and state-changing actions separated."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/agent-manifest.json"
    ],
    "llmContext": [
      "/llms.txt",
      "/llms-full.txt"
    ],
    "openapi": "/ai/openapi.json",
    "mcp": "/ai/mcp"
  },
  "knowledge": [
    {
      "id": "site-summary",
      "type": "summary",
      "source": "/llms.txt",
      "refresh": "on deploy"
    },
    {
      "id": "public-pages",
      "type": "catalog",
      "source": "/ai/catalog/pages.json",
      "refresh": "daily"
    },
    {
      "id": "policies",
      "type": "policy",
      "source": "/ai/policies.json",
      "refresh": "on policy change"
    }
  ],
  "capabilities": [
    {
      "id": "read-site-summary",
      "name": "Read site summary",
      "description": "Understand organization.",
      "intent": "understand_organization",
      "type": "resource",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/read-site-summary.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        }
      ],
      "audit": [
        "request_id"
      ]
    },
    {
      "id": "search-public-content",
      "name": "Search public content",
      "description": "Find public information.",
      "intent": "find_public_information",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/search-public-content.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        },
        {
          "kind": "openapi",
          "spec": "/ai/openapi.json",
          "operationId": "findPublicInformation",
          "priority": 2,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "query",
        "result_count"
      ]
    },
    {
      "id": "request-contact",
      "name": "Request contact",
      "description": "Submit contact request.",
      "intent": "submit_contact_request",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/request-contact.input.json",
      "outputSchema": "/ai/schemas/request-contact.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "openapi",
          "spec": "/ai/openapi.json",
          "operationId": "submitContactRequest",
          "priority": 1,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "input_summary",
        "user_confirmation",
        "timestamp"
      ]
    }
  ],
  "policies": {
    "consent": "Consent must be tied to a specific capability, input summary, user and timestamp.",
    "auth": "Public read capabilities do not require authentication. State-changing capabilities may require additional validation.",
    "dataMinimization": "Collect only fields required for the selected capability.",
    "audit": "Store enough metadata to reconstruct what the agent submitted and what the user approved."
  },
  "extensionPoints": [
    "openapi.example.json",
    "mcp-server.example.json",
    "catalog.example.json",
    "policy.example.json",
    "validation-report.example.json"
  ]
}
