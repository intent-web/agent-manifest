{
  "openapi": "3.1.0",
  "info": {
    "title": "Example Organization Agent API",
    "version": "0.1-draft"
  },
  "servers": [
    {
      "url": "https://example.com"
    }
  ],
  "paths": {
    "/ai/search": {
      "post": {
        "operationId": "search_site",
        "summary": "Search public site content",
        "x-agent-capability": "search-public-content",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results"
          }
        }
      }
    },
    "/ai/request-offer": {
      "post": {
        "operationId": "request_offer",
        "summary": "Submit a contact or offer request",
        "x-agent-capability": "request-contact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "message", "consentId"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "message": {
                    "type": "string"
                  },
                  "consentId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Offer request accepted"
          }
        }
      }
    }
  }
}
