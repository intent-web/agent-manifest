  "platform": {"type": "wordpress-membership-plugin", "stack": ["wordpress", "memberpress", "php", "mysql"], "integrationMode": "bridge-or-runtime", "servingNotes": ["Separate public marketing content from protected member content.", "Treat membership purchases, cancellations and access changes as high or critical risk."]},
  "discovery": {"recommendedLocations": ["/.well-known/agent-manifest.json", "/wp-json/agent-layer/v1/manifest"], "llmContext": ["/llms.txt", "/ai/memberships/plans.txt"], "openapi": "/wp-json/agent-layer/v1/openapi.json", "mcp": "/wp-json/agent-layer/v1/mcp"},
  "knowledge": [
    {"id": "plans", "type": "membership-plan-catalog", "source": "/ai/memberships/plans.json", "refresh": "on plan update"},
    {"id": "public-content", "type": "content-catalog", "source": "/ai/memberships/public-content.json", "refresh": "on publish"},
    {"id": "terms", "type": "policy", "source": "/membership-terms", "refresh": "on policy change"}
