  "capabilities": [
    {"id": "compare-memberships", "intent": "compare_membership_plans", "risk": "low", "stateChange": false, "requiresConsent": false, "protocols": ["static"], "audit": ["plan_ids"]},
    {"id": "check-access-requirements", "intent": "check_content_access_requirements", "risk": "low", "stateChange": false, "requiresConsent": false, "protocols": ["wordpress-rest"], "audit": ["content_id"]},
    {"id": "prepare-membership-signup", "intent": "prepare_membership_signup", "risk": "medium", "stateChange": true, "requiresConsent": true, "protocols": ["agent-action-gateway"], "audit": ["plan_summary", "user_confirmation"]},
    {"id": "start-membership", "intent": "start_paid_membership", "risk": "critical", "stateChange": true, "requiresConsent": true, "protocols": ["agent-action-gateway"], "audit": ["plan", "billing_terms", "explicit_approval"]}
  ],
  "policies": {"consent": "Paid membership start requires explicit approval of price, billing interval and cancellation terms.", "auth": "Protected content and account actions require authenticated member context.", "dataMinimization": "Do not expose protected content in public knowledge catalogs.", "audit": "Membership starts, cancellations and access changes require audit records."},
  "extensionPoints": ["membership-plan-schema.json", "memberpress-openapi.json", "protected-content-policy.json", "billing-consent-policy.json"]
