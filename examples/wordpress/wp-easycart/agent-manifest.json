{
  "agentManifestVersion": "0.1-draft",
  "id": "wordpress-wp-easycart-store",
  "status": "example",
  "templateKind": "wordpress-commerce",
  "identity": {
    "name": "Example WP EasyCart Store",
    "domain": "example.com",
    "owner": "Example Merchant",
    "contact": "orders@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "wordpress-ecommerce-plugin",
    "stack": [
      "wordpress",
      "wp-easycart",
      "php",
      "mysql"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Normalize product, shipping and tax data into agent-readable catalogs.",
      "Use an action gateway for cart and checkout operations."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/wp-json/agent-layer/v1/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/easycart/catalog-summary.txt"
    ],
    "openapi": "/wp-json/agent-layer/v1/openapi.json",
    "mcp": "/wp-json/agent-layer/v1/mcp"
  },
  "knowledge": [
    {
      "id": "products",
      "type": "product-catalog",
      "source": "/ai/easycart/products.json",
      "refresh": "on product update"
    },
    {
      "id": "tax-shipping",
      "type": "commerce-policy",
      "source": "/ai/easycart/tax-shipping.json",
      "refresh": "on setting change"
    },
    {
      "id": "returns",
      "type": "policy",
      "source": "/returns",
      "refresh": "on policy change"
    }
  ],
  "capabilities": [
    {
      "id": "search-products",
      "name": "Search products",
      "description": "Find products.",
      "intent": "find_products",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/search-products.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        },
        {
          "kind": "http",
          "endpoint": "/api/agent/search-products",
          "method": "GET",
          "contentType": "application/json",
          "priority": 2,
          "schemaMode": "none",
          "sourceAdapter": "wordpress-rest"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "calculate-total",
      "name": "Calculate total",
      "description": "Calculate total cost.",
      "intent": "calculate_total_cost",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/calculate-total",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "cart_items",
        "destination_region"
      ]
    },
    {
      "id": "prepare-cart",
      "name": "Prepare cart",
      "description": "Prepare cart for review.",
      "intent": "prepare_cart_for_review",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/prepare-cart.input.json",
      "outputSchema": "/ai/schemas/prepare-cart.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/prepare-cart",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "cart_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "place-order",
      "name": "Place order",
      "description": "Place order.",
      "intent": "place_order",
      "type": "transaction",
      "risk": "critical",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/place-order.input.json",
      "outputSchema": "/ai/schemas/place-order.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/place-order",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "order_summary",
        "explicit_approval"
      ]
    }
  ],
  "policies": {
    "consent": "Order placement requires explicit approval of item list, shipping, tax and total.",
    "auth": "Customer-specific order history requires authentication.",
    "dataMinimization": "Expose inventory and pricing only for public, purchasable products.",
    "audit": "Critical checkout actions require durable audit entries."
  },
  "extensionPoints": [
    "easycart-openapi.json",
    "cart-total-schema.json",
    "shipping-policy.json",
    "checkout-policy.json"
  ]
}
