{
  "agentManifestVersion": "0.1-draft",
  "id": "wordpress-surecart-store",
  "status": "example",
  "templateKind": "wordpress-commerce",
  "identity": {
    "name": "Example SureCart Store",
    "domain": "example.com",
    "owner": "Example Merchant",
    "contact": "sales@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "wordpress-ecommerce-plugin",
    "stack": [
      "wordpress",
      "surecart",
      "php",
      "hosted-commerce-services"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Keep hosted checkout boundaries explicit.",
      "Represent subscriptions, trials and one-time purchases as distinct capabilities."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/wp-json/agent-layer/v1/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/surecart/products.txt"
    ],
    "openapi": "/wp-json/agent-layer/v1/openapi.json",
    "mcp": "/wp-json/agent-layer/v1/mcp"
  },
  "knowledge": [
    {
      "id": "products",
      "type": "commerce-catalog",
      "source": "/ai/surecart/products.json",
      "refresh": "on product update"
    },
    {
      "id": "subscription-terms",
      "type": "policy",
      "source": "/subscription-terms",
      "refresh": "on policy change"
    },
    {
      "id": "checkout-policy",
      "type": "policy",
      "source": "/ai/surecart/checkout-policy.json",
      "refresh": "on checkout setting change"
    }
  ],
  "capabilities": [
    {
      "id": "search-products",
      "name": "Search products",
      "description": "Find products or plans.",
      "intent": "find_products_or_plans",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/search-products.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        },
        {
          "kind": "http",
          "endpoint": "/api/agent/search-products",
          "method": "GET",
          "contentType": "application/json",
          "priority": 2,
          "schemaMode": "none",
          "sourceAdapter": "wordpress-rest"
        }
      ],
      "audit": [
        "query"
      ]
    },
    {
      "id": "compare-plans",
      "name": "Compare plans",
      "description": "Compare subscription plans.",
      "intent": "compare_subscription_plans",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "static",
          "url": "/ai/capabilities/compare-plans.json",
          "method": "GET",
          "priority": 1,
          "schemaMode": "none"
        }
      ],
      "audit": [
        "plan_ids"
      ]
    },
    {
      "id": "create-checkout-session",
      "name": "Create checkout session",
      "description": "Prepare checkout session.",
      "intent": "prepare_checkout_session",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/create-checkout-session.input.json",
      "outputSchema": "/ai/schemas/create-checkout-session.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/create-checkout-session",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "checkout_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "confirm-subscription",
      "name": "Confirm subscription",
      "description": "Start subscription.",
      "intent": "start_subscription",
      "type": "transaction",
      "risk": "critical",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/confirm-subscription.input.json",
      "outputSchema": "/ai/schemas/confirm-subscription.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "hosted-checkout",
          "url": "/checkout",
          "method": "GET",
          "priority": 1,
          "schemaMode": "external"
        }
      ],
      "audit": [
        "plan",
        "trial",
        "renewal_terms",
        "explicit_approval"
      ]
    }
  ],
  "policies": {
    "consent": "Subscription start requires explicit approval of price, renewal interval, trial length and cancellation terms.",
    "auth": "Customer portal actions require authenticated customer context.",
    "dataMinimization": "Do not expose payment identifiers or hosted checkout secrets.",
    "audit": "Subscription starts and cancellations require audit records."
  },
  "extensionPoints": [
    "surecart-openapi.json",
    "subscription-policy.json",
    "checkout-session-schema.json",
    "customer-portal-policy.json"
  ]
}
