{
  "agentManifestVersion": "0.1-draft",
  "id": "wordpress-woocommerce-store",
  "status": "example",
  "templateKind": "wordpress-commerce",
  "identity": {
    "name": "Example WooCommerce Store",
    "domain": "example.com",
    "owner": "Example Merchant",
    "contact": "shop@example.com",
    "jurisdiction": "TODO"
  },
  "platform": {
    "type": "wordpress-ecommerce-plugin",
    "stack": [
      "wordpress",
      "woocommerce",
      "php",
      "mysql"
    ],
    "integrationMode": "bridge-or-runtime",
    "servingNotes": [
      "Generate product knowledge from published, purchasable products only.",
      "Treat checkout, payment, refunds and order placement as critical capabilities."
    ]
  },
  "discovery": {
    "recommendedLocations": [
      "/.well-known/agent-manifest.json",
      "/wp-json/agent-layer/v1/manifest"
    ],
    "llmContext": [
      "/llms.txt",
      "/ai/woocommerce/catalog-summary.txt"
    ],
    "openapi": "/wp-json/agent-layer/v1/openapi.json",
    "mcp": "/wp-json/agent-layer/v1/mcp"
  },
  "knowledge": [
    {
      "id": "products",
      "type": "product-catalog",
      "source": "/wp-json/wc/store/v1/products",
      "refresh": "on product update"
    },
    {
      "id": "shipping-zones",
      "type": "fulfillment-policy",
      "source": "/ai/woocommerce/shipping.json",
      "refresh": "on shipping setting change"
    },
    {
      "id": "returns",
      "type": "policy",
      "source": "/returns",
      "refresh": "on policy change"
    }
  ],
  "capabilities": [
    {
      "id": "search-products",
      "name": "Search products",
      "description": "Find products.",
      "intent": "find_products",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/search-products",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "woocommerce-store-api"
        },
        {
          "kind": "static",
          "url": "/ai/capabilities/search-products.json",
          "method": "GET",
          "priority": 2,
          "schemaMode": "none"
        }
      ],
      "audit": [
        "query",
        "filters"
      ]
    },
    {
      "id": "check-availability",
      "name": "Check availability",
      "description": "Check product availability.",
      "intent": "check_product_availability",
      "type": "query",
      "risk": "low",
      "stateChange": false,
      "consentMode": "none",
      "requiresConsent": false,
      "requiresAuthentication": false,
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/check-availability",
          "method": "GET",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "none",
          "sourceAdapter": "woocommerce-store-api"
        }
      ],
      "audit": [
        "product_id",
        "quantity"
      ]
    },
    {
      "id": "prepare-cart",
      "name": "Prepare cart",
      "description": "Prepare cart for review.",
      "intent": "prepare_cart_for_review",
      "type": "action",
      "risk": "medium",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": false,
      "inputSchema": "/ai/schemas/prepare-cart.input.json",
      "outputSchema": "/ai/schemas/prepare-cart.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "none",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/prepare-cart",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "cart_summary",
        "user_confirmation"
      ]
    },
    {
      "id": "place-order",
      "name": "Place order",
      "description": "Place order.",
      "intent": "place_order",
      "type": "transaction",
      "risk": "critical",
      "stateChange": true,
      "consentMode": "explicit",
      "requiresConsent": true,
      "requiresAuthentication": true,
      "inputSchema": "/ai/schemas/place-order.input.json",
      "outputSchema": "/ai/schemas/place-order.output.json",
      "enforcement": {
        "inputValidation": "server",
        "policy": "server",
        "consent": "server",
        "auth": "server",
        "audit": true,
        "idempotency": true
      },
      "bindings": [
        {
          "kind": "http",
          "endpoint": "/api/agent/place-order",
          "method": "POST",
          "contentType": "application/json",
          "priority": 1,
          "schemaMode": "inherits",
          "sourceAdapter": "agent-action-gateway"
        }
      ],
      "audit": [
        "order_summary",
        "payment_method",
        "explicit_approval",
        "timestamp"
      ]
    }
  ],
  "policies": {
    "consent": "Cart preparation and order placement must show item, quantity, taxes, shipping, discounts and total before approval.",
    "auth": "Customer-specific prices, addresses and previous orders require customer authentication.",
    "dataMinimization": "Do not expose unpublished products or private customer data.",
    "audit": "Critical order actions require immutable audit entries."
  },
  "extensionPoints": [
    "woocommerce-openapi.json",
    "cart-policy.json",
    "payment-risk-policy.json",
    "fulfillment-catalog.json"
  ]
}
